# Chatwoot, CloudTalk, SFTP y transcripción también se cargan desde el panel
# (General y Transcripción); lo del panel pisa a estas variables.
CHATWOOT_BASE_URL=https://chat.miempresa.com
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=
APP_USERNAME=reportes
APP_PASSWORD_HASH=
APP_COOKIE_KEY=
# Llave para cifrar las claves guardadas en el panel (por defecto, APP_COOKIE_KEY).
PANEL_CLAVE_CIFRADO=
DATABASE_URL=postgres://panel:clave@postgres:5432/panel
RINGOVER_API_TOKEN=
CLOUDTALK_API_KEY_ID=
CLOUDTALK_API_KEY_SECRET=
SYNC_INTERVALO_MINUTOS=15
SYNC_DIAS_INICIALES=30
CHATWOOT_DIAS_RELECTURA=14
ALMACEN_TIPO=
FTP_HOST=
FTP_PORT=8023
FTP_USER=
FTP_PASSWORD=
FTP_DIR=/
SFTP_HUELLA_HOST=
AUDIO_RETENCION_DIAS=90
TRANSCRIPCION_PROVEEDOR=openai
TRANSCRIPCION_RESPALDO=
TRANSCRIPCION_VOCABULARIO=
CLOUDTALK_CANAL_AGENTE=izquierdo
OPENAI_API_KEY=
OPENAI_MODELO_TRANSCRIPCION=gpt-4o-transcribe-diarize
OPENAI_PRECIO_MINUTO=
DATA_DIR=/data
TZ=America/Bogota
